#include "esp_err.h"
#include "esp_log.h"
#include "esp_event.h"
#include "esp_netif.h"
#include "esp_netif_sntp.h"
#include "esp_wifi.h"
#include "esp_mac.h"
#include "esp_system.h"
#include "esp_timer.h"

#include "driver/i2c_master.h"
#include "driver/uart.h"

#include "nvs_flash.h"
#include "esp_crt_bundle.h"
#include "mqtt_client.h"

#include "lwip/ip4_addr.h"

#include "gms.h"

/* =====================================================
   HARDWARE CONFIGURATION
   ===================================================== */

#define I2C_PORT             I2C_NUM_0
#define I2C_SDA_PIN          8
#define I2C_SCL_PIN          9
#define ADS1115_ADDR         0x48

#define SHUNT_OHMS           56.0f
#define ADC_AVERAGE          5

#define MODBUS_UART          UART_NUM_1
#define MODBUS_TX_PIN        15
#define MODBUS_RX_PIN        16
#define MODBUS_RTS_PIN       14
#define MODBUS_BAUD          9600

#define EWIG_SLAVE_ID        1
#define EWIG_FUNCTION        0x03
#define EWIG_REG_START       9
#define EWIG_REG_COUNT       12

/* =====================================================
   MQTT CONFIGURATION
   ===================================================== */

#define GMS_DEVICE_NAME          "GMS-001"

#define GMS_TOPIC_TELEMETRY \
    "v1/devices/me/telemetry"

#define GMS_TOPIC_ATTRIBUTES \
    "v1/devices/me/attributes"

#define GMS_TOPIC_RPC_REQUEST \
    "v1/devices/me/rpc/request/+"

/* =====================================================
   GLOBAL VARIABLES
   ===================================================== */

static const char *TAG = "GMS_MQTT";

static EventGroupHandle_t s_wifi_events;

#define WIFI_GOT_IP_BIT BIT0

static esp_mqtt_client_handle_t s_mqtt_client = NULL;

static volatile bool s_mqtt_connected = false;

static bool s_mqtt_started = false;
static bool s_sntp_started = false;

static i2c_master_dev_handle_t s_ads;

static bool s_adc_ready = false;
static bool s_rs485_ready = false;

static esp_netif_t *s_sta_netif;

static portMUX_TYPE s_data_lock =
    portMUX_INITIALIZER_UNLOCKED;

static gms_measurement_t s_last;

static char s_ap_name[40];
static char s_mqtt_uri[150];

/* =====================================================
   ANALOG DATA STRUCTURE
   ===================================================== */

typedef struct {
    bool ok;
    int16_t raw;
    float voltage;
    float ma;
} analog_value_t;

/* =====================================================
   ADS1115 REGISTER READ
   ===================================================== */

static esp_err_t ads_reg_read(
    uint8_t reg,
    uint16_t *value
) {
    uint8_t response[2] = {0};

    esp_err_t err = i2c_master_transmit_receive(
        s_ads,
        &reg,
        1,
        response,
        2,
        250
    );

    if (err == ESP_OK) {
        *value =
            ((uint16_t)response[0] << 8) |
            response[1];
    }

    return err;
}

/* =====================================================
   ADS1115 SINGLE CONVERSION
   ===================================================== */

static esp_err_t ads_one_conversion(
    uint8_t ain,
    int16_t *raw
) {
    if (ain > 3) {
        return ESP_ERR_INVALID_ARG;
    }

    const uint16_t cfg =
        (uint16_t)(
            0x8583u |
            ((uint16_t)(4u + ain) << 12)
        );

    const uint8_t tx[3] = {
        0x01,
        (uint8_t)(cfg >> 8),
        (uint8_t)cfg
    };

    esp_err_t err = i2c_master_transmit(
        s_ads,
        tx,
        sizeof(tx),
        250
    );

    if (err != ESP_OK) {
        return err;
    }

    for (int retry = 0; retry < 15; retry++) {

        vTaskDelay(pdMS_TO_TICKS(10));

        uint16_t status = 0;

        err = ads_reg_read(0x01, &status);

        if (err != ESP_OK) {
            return err;
        }

        if (status & 0x8000u) {

            uint16_t conv = 0;

            err = ads_reg_read(
                0x00,
                &conv
            );

            if (err == ESP_OK) {
                *raw = (int16_t)conv;
            }

            return err;
        }
    }

    return ESP_ERR_TIMEOUT;
}

/* =====================================================
   READ ANALOG SENSOR
   ===================================================== */

static analog_value_t read_analog(
    uint8_t channel
) {
    analog_value_t result = {0};

    int32_t sum = 0;
    int count = 0;

    if (!s_adc_ready) {
        return result;
    }

    for (int i = 0; i < ADC_AVERAGE; i++) {

        int16_t sample = 0;

        if (
            ads_one_conversion(
                channel,
                &sample
            ) == ESP_OK
        ) {
            sum += sample;
            count++;
        }
    }

    if (count == 0) {
        return result;
    }

    result.ok = true;

    result.raw =
        (int16_t)(sum / count);

    result.voltage =
        ((float)sum / count) *
        (2.048f / 32768.0f);

    result.ma =
        (result.voltage / SHUNT_OHMS) *
        1000.0f;

    return result;
}

/* =====================================================
   INITIALIZE ADS1115
   ===================================================== */

static void init_adc(void) {

    i2c_master_bus_config_t bus_config = {
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .i2c_port = I2C_PORT,
        .sda_io_num = I2C_SDA_PIN,
        .scl_io_num = I2C_SCL_PIN,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true
    };

    i2c_master_bus_handle_t bus = NULL;

    esp_err_t er = i2c_new_master_bus(
        &bus_config,
        &bus
    );

    if (er != ESP_OK) {
        ESP_LOGE(
            TAG,
            "I2C bus failed: %s",
            esp_err_to_name(er)
        );
        return;
    }

    i2c_device_config_t device_config = {
        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
        .device_address = ADS1115_ADDR,
        .scl_speed_hz = 100000
    };

    er = i2c_master_bus_add_device(
        bus,
        &device_config,
        &s_ads
    );

    if (er != ESP_OK) {
        ESP_LOGE(
            TAG,
            "ADS1115 add failed: %s",
            esp_err_to_name(er)
        );
        return;
    }

    er = i2c_master_probe(
        bus,
        ADS1115_ADDR,
        250
    );

    if (er != ESP_OK) {
        ESP_LOGW(
            TAG,
            "ADS1115 not detected"
        );
        return;
    }

    s_adc_ready = true;

    ESP_LOGI(
        TAG,
        "ADS1115 READY | A0=TEMP A2=LEVEL A3=PRESSURE"
    );
}

/* =====================================================
   INITIALIZE RS485
   ===================================================== */

static void init_rs485(void) {

    const uart_config_t uart_config = {
        .baud_rate = MODBUS_BAUD,
        .data_bits = UART_DATA_8_BITS,
        .parity = UART_PARITY_DISABLE,
        .stop_bits = UART_STOP_BITS_1,
        .flow_ctrl = UART_HW_FLOWCTRL_DISABLE,
        .source_clk = UART_SCLK_DEFAULT
    };

    esp_err_t er = uart_driver_install(
        MODBUS_UART,
        512,
        0,
        0,
        NULL,
        0
    );

    if (er != ESP_OK) {
        ESP_LOGE(
            TAG,
            "RS485 UART install failed"
        );
        return;
    }

    er = uart_param_config(
        MODBUS_UART,
        &uart_config
    );

    if (er == ESP_OK) {
        er = uart_set_pin(
            MODBUS_UART,
            MODBUS_TX_PIN,
            MODBUS_RX_PIN,
            MODBUS_RTS_PIN,
            UART_PIN_NO_CHANGE
        );
    }

    if (er == ESP_OK) {
        er = uart_set_mode(
            MODBUS_UART,
            UART_MODE_RS485_HALF_DUPLEX
        );
    }

    if (er != ESP_OK) {
        ESP_LOGE(
            TAG,
            "RS485 config failed: %s",
            esp_err_to_name(er)
        );
        return;
    }

    s_rs485_ready = true;

    ESP_LOGI(
        TAG,
        "RS485 READY | TX15 RX16 RTS14"
    );
}

/* =====================================================
   MODBUS CRC16
   ===================================================== */

static uint16_t modbus_crc16(
    const uint8_t *data,
    size_t length
) {
    uint16_t crc = 0xFFFF;

    for (size_t i = 0; i < length; i++) {

        crc ^= data[i];

        for (unsigned b = 0; b < 8; b++) {

            if (crc & 1u) {
                crc =
                    (uint16_t)(
                        (crc >> 1) ^ 0xA001u
                    );
            } else {
                crc =
                    (uint16_t)(crc >> 1);
            }
        }
    }

    return crc;
}

/* =====================================================
   EWIG MODBUS READ
   ===================================================== */

static bool ewig_read_raw(
    uint16_t regs[EWIG_REG_COUNT]
) {
    if (!s_rs485_ready) {
        return false;
    }

    uint8_t query[8] = {
        EWIG_SLAVE_ID,
        EWIG_FUNCTION,
        (uint8_t)(EWIG_REG_START >> 8),
        (uint8_t)EWIG_REG_START,
        (uint8_t)(EWIG_REG_COUNT >> 8),
        (uint8_t)EWIG_REG_COUNT,
        0,
        0
    };

    uint16_t crc = modbus_crc16(
        query,
        6
    );

    query[6] = (uint8_t)crc;
    query[7] = (uint8_t)(crc >> 8);

    ESP_ERROR_CHECK(
        uart_flush_input(MODBUS_UART)
    );

    int tx = uart_write_bytes(
        MODBUS_UART,
        (const char *)query,
        sizeof(query)
    );

    if (tx != sizeof(query)) {
        ESP_LOGW(
            TAG,
            "EWIG TX failed"
        );
        return false;
    }

    if (
        uart_wait_tx_done(
            MODBUS_UART,
            pdMS_TO_TICKS(200)
        ) != ESP_OK
    ) {
        ESP_LOGW(
            TAG,
            "EWIG TX timeout"
        );
        return false;
    }

    uint8_t response[64] = {0};

    size_t received = 0;
    int expected = -1;

    const TickType_t deadline =
        xTaskGetTickCount() +
        pdMS_TO_TICKS(500);

    while (
        (int32_t)(
            deadline - xTaskGetTickCount()
        ) > 0 &&
        received < sizeof(response)
    ) {

        int n = uart_read_bytes(
            MODBUS_UART,
            response + received,
            sizeof(response) - received,
            pdMS_TO_TICKS(40)
        );

        if (n > 0) {
            received += (size_t)n;
        }

        if (received >= 3) {

            expected =
                (response[1] & 0x80)
                ? 5
                : (5 + response[2]);

            if (
                expected >
                (int)sizeof(response)
            ) {
                break;
            }

            if (
                received >=
                (size_t)expected
            ) {
                break;
            }
        }
    }

    if (
        received < 5 ||
        expected <= 0 ||
        received != (size_t)expected
    ) {
        ESP_LOGW(
            TAG,
            "EWIG incomplete response"
        );
        return false;
    }

    const uint16_t rx_crc =
        (uint16_t)response[received - 2] |
        ((uint16_t)response[received - 1] << 8);

    if (
        rx_crc !=
        modbus_crc16(
            response,
            received - 2
        )
    ) {
        ESP_LOGW(
            TAG,
            "EWIG CRC incorrect"
        );
        return false;
    }

    if (
        response[0] != EWIG_SLAVE_ID
    ) {
        return false;
    }

    if (
        response[1] ==
        (EWIG_FUNCTION | 0x80u)
    ) {
        ESP_LOGW(
            TAG,
            "EWIG Modbus exception"
        );
        return false;
    }

    if (
        response[1] != EWIG_FUNCTION ||
        response[2] != EWIG_REG_COUNT * 2u
    ) {
        return false;
    }

    for (
        int i = 0;
        i < EWIG_REG_COUNT;
        i++
    ) {
        regs[i] =
            ((uint16_t)response[3 + i * 2] << 8) |
            response[4 + i * 2];
    }

    return true;
}

/* =====================================================
   SENSOR LOGGING
   ===================================================== */

static void print_sensor(
    const char *name,
    int ain,
    analog_value_t v
) {
    if (!v.ok) {
        ESP_LOGW(
            TAG,
            "%s A%d ADC FAILED",
            name,
            ain
        );
        return;
    }

    const char *quality =
        (v.ma <= 3.6f || v.ma >= 21.0f)
        ? "CHECK_LOOP"
        : (v.ma < 4.0f || v.ma > 20.0f)
        ? "NEAR_OUTSIDE_RANGE"
        : "NOMINAL";

    ESP_LOGI(
        TAG,
        "%s A%d | RAW=%d | %.4f V | %.3f mA | %s",
        name,
        ain,
        v.raw,
        v.voltage,
        v.ma,
        quality
    );
}

/* =====================================================
   GMS SNAPSHOT
   ===================================================== */

void gms_get_snapshot(
    gms_measurement_t *out
) {
    portENTER_CRITICAL(
        &s_data_lock
    );

    *out = s_last;

    portEXIT_CRITICAL(
        &s_data_lock
    );
}

/* =====================================================
   CONNECTION STATUS
   ===================================================== */

bool gms_wifi_online(void) {

    return
        s_wifi_events &&
        (
            xEventGroupGetBits(
                s_wifi_events
            ) & WIFI_GOT_IP_BIT
        );
}

bool gms_mqtt_online(void) {

    return s_mqtt_connected;
}

void gms_get_station_ip(
    char out[16]
) {
    esp_netif_ip_info_t info = {0};

    if (
        s_sta_netif &&
        gms_wifi_online() &&
        esp_netif_get_ip_info(
            s_sta_netif,
            &info
        ) == ESP_OK
    ) {
        snprintf(
            out,
            16,
            IPSTR,
            IP2STR(&info.ip)
        );
    } else {
        strcpy(out, "-");
    }
}

void gms_get_ap_ssid(
    char out[40]
) {
    strcpy(
        out,
        s_ap_name
    );
}

/* =====================================================
   RESTART
   ===================================================== */

static void restart_task(
    void *p
) {
    (void)p;

    vTaskDelay(
        pdMS_TO_TICKS(1600)
    );

    esp_restart();
}

void gms_schedule_restart(void) {

    xTaskCreate(
        restart_task,
        "cfg_restart",
        2048,
        NULL,
        3,
        NULL
    );
}

/* =====================================================
   WIFI EVENTS
   ===================================================== */

static void wifi_events(
    void *arg,
    esp_event_base_t base,
    int32_t event_id,
    void *data
) {
    (void)arg;

    if (
        base == WIFI_EVENT &&
        event_id == WIFI_EVENT_STA_START
    ) {
        if (gms_settings.ssid[0]) {
            esp_wifi_connect();
        }

    } else if (
        base == WIFI_EVENT &&
        event_id == WIFI_EVENT_STA_DISCONNECTED
    ) {
        s_mqtt_connected = false;

        xEventGroupClearBits(
            s_wifi_events,
            WIFI_GOT_IP_BIT
        );

        wifi_event_sta_disconnected_t *e =
            data;

        ESP_LOGW(
            TAG,
            "WiFi disconnected reason=%d",
            e ? (int)e->reason : -1
        );

        if (gms_settings.ssid[0]) {
            esp_wifi_connect();
        }

    } else if (
        base == IP_EVENT &&
        event_id == IP_EVENT_STA_GOT_IP
    ) {
        ip_event_got_ip_t *e = data;

        ESP_LOGI(
            TAG,
            "GMS STA IP: " IPSTR,
            IP2STR(&e->ip_info.ip)
        );

        xEventGroupSetBits(
            s_wifi_events,
            WIFI_GOT_IP_BIT
        );
    }
}

/* =====================================================
   IP PARSER
   ===================================================== */

static bool parse_ip4(
    const char *text,
    esp_ip4_addr_t *dest
) {
    ip4_addr_t temp;

    if (!ip4addr_aton(text, &temp)) {
        return false;
    }

    dest->addr = temp.addr;

    return true;
}

/* =====================================================
   WIFI AP + STATION
   ===================================================== */

static void wifi_start_apsta(void) {

    ESP_ERROR_CHECK(
        esp_netif_init()
    );

    ESP_ERROR_CHECK(
        esp_event_loop_create_default()
    );

    s_wifi_events =
        xEventGroupCreate();

    configASSERT(s_wifi_events);

    esp_netif_t *ap =
        esp_netif_create_default_wifi_ap();

    (void)ap;

    s_sta_netif =
        esp_netif_create_default_wifi_sta();

    wifi_init_config_t init =
        WIFI_INIT_CONFIG_DEFAULT();

    ESP_ERROR_CHECK(
        esp_wifi_init(&init)
    );

    ESP_ERROR_CHECK(
        esp_event_handler_register(
            WIFI_EVENT,
            ESP_EVENT_ANY_ID,
            wifi_events,
            NULL
        )
    );

    ESP_ERROR_CHECK(
        esp_event_handler_register(
            IP_EVENT,
            IP_EVENT_STA_GOT_IP,
            wifi_events,
            NULL
        )
    );

    uint8_t mac[6];

    ESP_ERROR_CHECK(
        esp_wifi_get_mac(
            WIFI_IF_AP,
            mac
        )
    );

    snprintf(
        s_ap_name,
        sizeof(s_ap_name),
        "GMS-Internal-%02X%02X",
        mac[4],
        mac[5]
    );

    char ap_pw[20] = {0};

    gms_store_get_ap_password(
        ap_pw
    );

    wifi_config_t cfg_ap = {0};

    /* AP SSID - FIX FORMAT TRUNCATION */

    size_t ap_ssid_len =
        strnlen(
            s_ap_name,
            sizeof(cfg_ap.ap.ssid)
        );

    memcpy(
        cfg_ap.ap.ssid,
        s_ap_name,
        ap_ssid_len
    );

    cfg_ap.ap.ssid_len =
        (uint8_t)ap_ssid_len;

    /* AP PASSWORD */

    size_t ap_pw_len =
        strnlen(
            ap_pw,
            sizeof(cfg_ap.ap.password)
        );

    memcpy(
        cfg_ap.ap.password,
        ap_pw,
        ap_pw_len
    );

    cfg_ap.ap.max_connection = 3;
    cfg_ap.ap.channel = 1;

    cfg_ap.ap.authmode =
        WIFI_AUTH_WPA2_PSK;

    cfg_ap.ap.pmf_cfg.required = true;

    /* WIFI STATION */

    wifi_config_t cfg_sta = {0};

    size_t sta_ssid_len =
        strnlen(
            gms_settings.ssid,
            sizeof(cfg_sta.sta.ssid)
        );

    memcpy(
        cfg_sta.sta.ssid,
        gms_settings.ssid,
        sta_ssid_len
    );

    size_t sta_pw_len =
        strnlen(
            gms_settings.wifi_password,
            sizeof(cfg_sta.sta.password)
        );

    memcpy(
        cfg_sta.sta.password,
        gms_settings.wifi_password,
        sta_pw_len
    );

    cfg_sta.sta.pmf_cfg.capable = true;

    /* STATIC IP CONFIGURATION */

    if (gms_settings.static_ip) {

        esp_netif_ip_info_t info = {0};
        esp_ip4_addr_t dns_addr = {0};

        if (
            parse_ip4(
                gms_settings.ip,
                &info.ip
            ) &&
            parse_ip4(
                gms_settings.mask,
                &info.netmask
            ) &&
            parse_ip4(
                gms_settings.gateway,
                &info.gw
            ) &&
            parse_ip4(
                gms_settings.dns,
                &dns_addr
            )
        ) {

            esp_err_t er =
                esp_netif_dhcpc_stop(
                    s_sta_netif
                );

            if (
                er != ESP_OK &&
                er !=
                ESP_ERR_ESP_NETIF_DHCP_ALREADY_STOPPED
            ) {
                ESP_LOGW(
                    TAG,
                    "DHCP stop failed: %s",
                    esp_err_to_name(er)
                );
            }

            ESP_ERROR_CHECK(
                esp_netif_set_ip_info(
                    s_sta_netif,
                    &info
                )
            );

            esp_netif_dns_info_t dns = {0};

            dns.ip.type =
                ESP_IPADDR_TYPE_V4;

            dns.ip.u_addr.ip4.addr =
                dns_addr.addr;

            ESP_ERROR_CHECK(
                esp_netif_set_dns_info(
                    s_sta_netif,
                    ESP_NETIF_DNS_MAIN,
                    &dns
                )
            );

            ESP_LOGW(
                TAG,
                "Using STATIC IPv4"
            );

        } else {

            ESP_LOGE(
                TAG,
                "Invalid Static IP configuration"
            );
        }
    }

    /* START WIFI */

    ESP_ERROR_CHECK(
        esp_wifi_set_mode(
            WIFI_MODE_APSTA
        )
    );

    ESP_ERROR_CHECK(
        esp_wifi_set_config(
            WIFI_IF_AP,
            &cfg_ap
        )
    );

    if (gms_settings.ssid[0]) {

        ESP_ERROR_CHECK(
            esp_wifi_set_config(
                WIFI_IF_STA,
                &cfg_sta
            )
        );
    }

    ESP_ERROR_CHECK(
        esp_wifi_start()
    );

    ESP_LOGW(
        TAG,
        "================================"
    );

    ESP_LOGW(
        TAG,
        "GMS LOCAL WEB"
    );

    ESP_LOGW(
        TAG,
        "AP IP: http://192.168.4.1"
    );

    ESP_LOGW(
        TAG,
        "AP SSID: %s",
        s_ap_name
    );

    ESP_LOGW(
        TAG,
        "AP Password: %s",
        ap_pw
    );

    ESP_LOGW(
        TAG,
        "STA WiFi: %s",
        gms_settings.ssid[0]
        ? gms_settings.ssid
        : "NOT CONFIGURED"
    );

    ESP_LOGW(
        TAG,
        "================================"
    );

    memset(
        ap_pw,
        0,
        sizeof(ap_pw)
    );
}

/* =====================================================
   NTP SYNC
   ===================================================== */

static bool sync_ntp(void) {

    if (!s_sntp_started) {

        esp_sntp_config_t cfg =
            ESP_NETIF_SNTP_DEFAULT_CONFIG(
                "pool.ntp.org"
            );

        esp_err_t er =
            esp_netif_sntp_init(
                &cfg
            );

        if (er != ESP_OK) {
            ESP_LOGW(
                TAG,
                "NTP initialization failed"
            );
            return false;
        }

        s_sntp_started = true;
    }

    for (int attempt = 0; attempt < 6; attempt++) {

        if (!gms_wifi_online()) {
            return false;
        }

        if (
            esp_netif_sntp_sync_wait(
                pdMS_TO_TICKS(5000)
            ) == ESP_OK
        ) {
            time_t now = time(NULL);

            if (now > 1700000000) {
                ESP_LOGI(
                    TAG,
                    "NTP synchronized"
                );
                return true;
            }
        }
    }

    return false;
}

/* =====================================================
   MQTT EVENTS
   ===================================================== */

static void mqtt_event(
    void *arg,
    esp_event_base_t base,
    int32_t id,
    void *data
) {
    (void)arg;
    (void)base;

    esp_mqtt_event_handle_t ev = data;

    switch ((esp_mqtt_event_id_t)id) {

        case MQTT_EVENT_CONNECTED:

            s_mqtt_connected = true;

            ESP_LOGI(
                TAG,
                "MQTT CONNECTED TLS"
            );

            esp_mqtt_client_subscribe(
                ev->client,
                GMS_TOPIC_ATTRIBUTES,
                1
            );

            esp_mqtt_client_subscribe(
                ev->client,
                GMS_TOPIC_RPC_REQUEST,
                1
            );

            break;

        case MQTT_EVENT_DISCONNECTED:

            s_mqtt_connected = false;

            ESP_LOGW(
                TAG,
                "MQTT disconnected"
            );

            break;

        case MQTT_EVENT_SUBSCRIBED:

            ESP_LOGI(
                TAG,
                "MQTT subscribed ID=%d",
                ev->msg_id
            );

            break;

        case MQTT_EVENT_PUBLISHED:

            ESP_LOGI(
                TAG,
                "MQTT published ID=%d",
                ev->msg_id
            );

            break;

        case MQTT_EVENT_DATA:

            ESP_LOGI(
                TAG,
                "MQTT RX topic=%.*s",
                ev->topic_len,
                ev->topic
            );

            /*
             * Read-only bench mode.
             * No relay activation.
             */

            if (
                ev->topic_len > 26 &&
                strncmp(
                    ev->topic,
                    "v1/devices/me/rpc/request/",
                    26
                ) == 0
            ) {

                const char *request_id =
                    ev->topic + 26;

                int n =
                    ev->topic_len - 26;

                if (n > 0 && n <= 24) {

                    char topic[85];

                    snprintf(
                        topic,
                        sizeof(topic),
                        "v1/devices/me/rpc/response/%.*s",
                        n,
                        request_id
                    );

                    esp_mqtt_client_publish(
                        ev->client,
                        topic,
                        "{\"error\":\"bench_read_only\"}",
                        0,
                        1,
                        0
                    );
                }
            }

            break;

        case MQTT_EVENT_ERROR:

            ESP_LOGW(
                TAG,
                "MQTT TLS connection error"
            );

            break;

        default:
            break;
    }
}

/* =====================================================
   MQTT START
   ===================================================== */

static void mqtt_start_stored_config(void) {

    if (!gms_settings.mqtt_token[0]) {

        ESP_LOGW(
            TAG,
            "MQTT token not configured"
        );

        return;
    }

    snprintf(
        s_mqtt_uri,
        sizeof(s_mqtt_uri),
        "mqtts://%s:%u",
        gms_settings.mqtt_host,
        (unsigned)gms_settings.mqtt_port
    );

    const esp_mqtt_client_config_t cfg = {
        .broker = {
            .address.uri = s_mqtt_uri,
            .verification.crt_bundle_attach =
                esp_crt_bundle_attach
        },
        .credentials = {
            .username =
                gms_settings.mqtt_token
        },
        .session = {
            .keepalive = 60
        }
    };

    s_mqtt_client =
        esp_mqtt_client_init(
            &cfg
        );

    if (!s_mqtt_client) {

        ESP_LOGE(
            TAG,
            "MQTT initialization failed"
        );

        return;
    }

    ESP_ERROR_CHECK(
        esp_mqtt_client_register_event(
            s_mqtt_client,
            ESP_EVENT_ANY_ID,
            mqtt_event,
            NULL
        )
    );

    ESP_ERROR_CHECK(
        esp_mqtt_client_start(
            s_mqtt_client
        )
    );

    s_mqtt_started = true;

    ESP_LOGI(
        TAG,
        "MQTT connecting to %s",
        gms_settings.mqtt_host
    );
}

/* =====================================================
   MQTT NETWORK TASK
   ===================================================== */

static void mqtt_network_task(
    void *arg
) {
    (void)arg;

    for (;;) {

        if (
            gms_wifi_online() &&
            !s_mqtt_started
        ) {

            if (sync_ntp()) {

                mqtt_start_stored_config();

            } else {

                ESP_LOGW(
                    TAG,
                    "NTP unavailable"
                );
            }
        }

        vTaskDelay(
            pdMS_TO_TICKS(5000)
        );
    }
}

/* =====================================================
   JSON BUILDER
   ===================================================== */

static void json_add(
    char *out,
    size_t len,
    size_t *used,
    const char *fmt,
    ...
) {
    if (*used >= len) {
        return;
    }

    va_list ap;

    va_start(ap, fmt);

    int n = vsnprintf(
        out + *used,
        len - *used,
        fmt,
        ap
    );

    va_end(ap);

    if (n > 0) {

        size_t d = (size_t)n;

        *used =
            (d >= len - *used)
            ? len
            : *used + d;
    }
}

/* =====================================================
   CURRENT LOOP VALIDATION
   ===================================================== */

static bool loop_in_service_range(
    analog_value_t v
) {
    return
        v.ok &&
        v.ma >= 3.6f &&
        v.ma <= 21.0f;
}

/* =====================================================
   MQTT TELEMETRY PUBLISH
   ===================================================== */

static void publish(
    analog_value_t t,
    analog_value_t l,
    analog_value_t p,
    bool ewig,
    const uint16_t *regs
) {
    if (
        !s_mqtt_connected ||
        !s_mqtt_client
    ) {
        return;
    }

    char json[1200] = {0};

    size_t u = 0;

    json_add(
        json,
        sizeof(json),
        &u,
        "{\"device\":\"GMS-001\","
        "\"bench_mode\":true,"
        "\"temp_adc_ok\":%s,"
        "\"level_adc_ok\":%s,"
        "\"pressure_adc_ok\":%s,"
        "\"temp_loop_ok\":%s,"
        "\"level_loop_ok\":%s,"
        "\"pressure_loop_ok\":%s,"
        "\"ewig_modbus_ok\":%s,"
        "\"ewig_measurement_valid\":false",

        t.ok ? "true" : "false",
        l.ok ? "true" : "false",
        p.ok ? "true" : "false",

        loop_in_service_range(t)
            ? "true" : "false",

        loop_in_service_range(l)
            ? "true" : "false",

        loop_in_service_range(p)
            ? "true" : "false",

        ewig ? "true" : "false"
    );

    /* TEMPERATURE */

    if (loop_in_service_range(t)) {

        json_add(
            json,
            sizeof(json),
            &u,
            ",\"temp_voltage\":%.4f,"
            "\"temp_ma\":%.3f,"
            "\"temp_percent\":%.2f",

            t.voltage,
            t.ma,
            (t.ma - 4.0f) * 6.25f
        );
    }

    /* LEVEL */

    if (loop_in_service_range(l)) {

        json_add(
            json,
            sizeof(json),
            &u,
            ",\"level_voltage\":%.4f,"
            "\"level_ma\":%.3f,"
            "\"level_percent\":%.2f",

            l.voltage,
            l.ma,
            (l.ma - 4.0f) * 6.25f
        );
    }

    /* PRESSURE */

    if (loop_in_service_range(p)) {

        float bar =
            (p.ma - 4.0f) *
            10.0f / 16.0f;

        if (bar < 0.0f) {
            bar = 0.0f;
        }

        if (bar > 10.0f) {
            bar = 10.0f;
        }

        json_add(
            json,
            sizeof(json),
            &u,
            ",\"pressure_voltage\":%.4f,"
            "\"pressure_ma\":%.3f,"
            "\"pressure_bar\":%.3f,"
            "\"pressure_calibrated\":false",

            p.voltage,
            p.ma,
            bar
        );
    }

    /* EWIG RAW */

    if (ewig && regs) {

        json_add(
            json,
            sizeof(json),
            &u,
            ",\"ewig_raw_r09\":%u,"
            "\"ewig_raw_r10\":%u",

            regs[0],
            regs[1]
        );
    }

    json_add(
        json,
        sizeof(json),
        &u,
        "}"
    );

    if (u >= sizeof(json)) {

        ESP_LOGE(
            TAG,
            "JSON buffer overflow prevented"
        );

        return;
    }

    int mid = esp_mqtt_client_publish(
        s_mqtt_client,
        GMS_TOPIC_TELEMETRY,
        json,
        0,
        1,
        0
    );

    if (mid >= 0) {

        ESP_LOGI(
            TAG,
            "MQTT TX ID=%d",
            mid
        );
    }
}

/* =====================================================
   SENSOR TELEMETRY TASK
   ===================================================== */

static void telemetry_task(
    void *arg
) {
    (void)arg;

    for (;;) {

        /* ADS1115 CHANNEL MAPPING */

        analog_value_t t =
            read_analog(0);

        analog_value_t l =
            read_analog(2);

        analog_value_t p =
            read_analog(3);

        /* EWIG */

        uint16_t regs[EWIG_REG_COUNT] = {0};

        bool ewig =
            ewig_read_raw(regs);

        /* SNAPSHOT */

        gms_measurement_t s = {0};

        analog_value_t values[] = {
            t,
            l,
            p
        };

        for (int i = 0; i < 3; i++) {

            s.adc_ok[i] =
                values[i].ok;

            s.loop_ok[i] =
                loop_in_service_range(
                    values[i]
                );

            s.volts[i] =
                values[i].voltage;

            s.ma[i] =
                values[i].ma;

            s.raw[i] =
                values[i].raw;
        }

        s.ewig_ok = ewig;

        s.ewig_raw[0] = regs[0];
        s.ewig_raw[1] = regs[1];

        /* PRESSURE CALCULATION */

        float bar =
            (p.ma - 4.0f) *
            10.0f / 16.0f;

        if (!loop_in_service_range(p)) {
            bar = 0.0f;
        }

        if (bar < 0.0f) {
            bar = 0.0f;
        }

        if (bar > 10.0f) {
            bar = 10.0f;
        }

        s.pressure_bar = bar;

        s.uptime_ms =
            (uint32_t)(
                esp_timer_get_time() / 1000
            );

        /* UPDATE SHARED DATA */

        portENTER_CRITICAL(
            &s_data_lock
        );

        s_last = s;

        portEXIT_CRITICAL(
            &s_data_lock
        );

        /* LOGGING */

        print_sensor(
            "SUHU",
            0,
            t
        );

        print_sensor(
            "LEVEL",
            2,
            l
        );

        print_sensor(
            "PRESSURE",
            3,
            p
        );

        ESP_LOGI(
            TAG,
            "EWIG %s",
            ewig
            ? "MODBUS OK"
            : "NO RESPONSE"
        );

        /* MQTT */

        publish(
            t,
            l,
            p,
            ewig,
            regs
        );

        uint32_t interval_ms =
            (uint32_t)gms_settings.interval_s *
            1000u;

        if (interval_ms < 1000u) {
            interval_ms = 1000u;
        }

        vTaskDelay(
            pdMS_TO_TICKS(interval_ms)
        );
    }
}

/* =====================================================
   APPLICATION MAIN
   ===================================================== */

void app_main(void) {

    ESP_LOGW(
        TAG,
        "GMS INTERNAL REAL HARDWARE"
    );

    ESP_LOGW(
        TAG,
        "BENCH TEST MODE"
    );

    ESP_LOGW(
        TAG,
        "NO RELAY CONTROL"
    );

    ESP_LOGW(
        TAG,
        "ADS1115 A0=TEMP A2=LEVEL A3=PRESSURE"
    );

    ESP_LOGW(
        TAG,
        "DO NOT CONNECT 24V DIRECTLY TO ADS1115"
    );

    /* INITIALIZE CONFIGURATION */

    gms_store_init();

    /* INITIALIZE HARDWARE */

    init_adc();

    init_rs485();

    /* INITIALIZE WIFI */

    wifi_start_apsta();

    /* START LOCAL WEB DASHBOARD */

    gms_web_start();

    /* START MQTT TASK */

    xTaskCreate(
        mqtt_network_task,
        "network_mqtt",
        6144,
        NULL,
        4,
        NULL
    );

    /* START SENSOR TASK */

    xTaskCreate(
        telemetry_task,
        "sensor_loop",
        6144,
        NULL,
        5,
        NULL
    );
}